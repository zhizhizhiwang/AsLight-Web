{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aslight",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aslight-dev",
      "database_id": "e13af6c9-c97f-4e8f-8b6e-12d69e03404f",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5173",
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "observability": { "enabled": true, "redact_query_string": true },
  // Development resource only. Production must use a separate DB, HTTPS origin,
  // independent platform secrets. See docs/DEPLOYMENT.md.
}
