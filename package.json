{
  "name": "aslight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run cf:typegen && npm run format:check && npm run typecheck && npm run check:boundaries && npm test && npm run build && npm run check:bundle && npm run test:integration",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run check && wrangler deploy",
    "build:production": "node scripts/production.mjs build",
    "deploy:production": "node scripts/production.mjs deploy",
    "db:migrate:production": "node scripts/production.mjs migrate",
    "cf:typegen": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "auth:admin": "node scripts/admin-access.mjs",
    "setup:local": "node scripts/setup-local.mjs && npm run db:migrate:local",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@xyflow/react": "12.12.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261023.0-beta",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
