{
  "name": "aslight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run format:check && npm run typecheck && npm run check:boundaries && npm test && npm run build && npm run check:bundle",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run check && wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
